          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "githubAuth": []
          }
        ]
      }
    },
    "/maintenance/order": {
      "get": {
        "tags": [
          "Maintenance"
        ],
        "summary": "List all maintenance orders",
        "description": "Returns every maintenance order in the collection.",
        "responses": {
          "200": {
            "description": "Maintenance orders returned"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "Maintenance"
        ],
        "summary": "Create a maintenance order",
        "description": "All fields are required. inventoryId must identify an existing inventory item. scheduledDate uses YYYY-MM-DD. status: scheduled, in-progress, completed, or cancelled. cost must be zero or greater.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Maintenance"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created. The response contains the new document id.",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "507f1f77bcf86cd799439011"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Invalid fields or inventory reference"
          },
          "401": {
            "description": "Authentication required. Please log in through GitHub."
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "githubAuth": []
          }
        ]
      }
    },
    "/maintenance/order/{id}": {
      "get": {
        "tags": [
          "Maintenance"
        ],
        "summary": "Get a maintenance order by ID",
        "description": "Returns the maintenance order matching the supplied MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The 24-character MongoDB ID of the maintenance order"
          }
        ],
        "responses": {
          "200": {
            "description": "Maintenance order returned"
          },
          "400": {
            "description": "Invalid document ID"
          },
          "404": {
            "description": "Maintenance order not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "tags": [
          "Maintenance"
        ],
        "summary": "Update a maintenance order",
        "description": "Send all fields. inventoryId must identify an existing inventory item. scheduledDate uses YYYY-MM-DD. status: scheduled, in-progress, completed, or cancelled. cost must be zero or greater.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The 24-character MongoDB ID of the maintenance order"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Maintenance"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Updated successfully. No response body."
          },
          "400": {
            "description": "Invalid ID, fields, or inventory reference"
          },
          "401": {
            "description": "Authentication required. Please log in through GitHub."
          },
          "404": {
            "description": "Maintenance order not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "githubAuth": []
          }
        ]
      }
    },
    "/reservations": {
      "get": {
        "tags": [
          "Reservations"
        ],
        "summary": "List all reservations",
        "description": "Returns every reservation in the collection.",
        "responses": {
          "200": {
            "description": "Reservations returned"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "Reservations"
        ],
        "summary": "Create a reservation",
        "description": "All fields are required. inventoryId and customerId must identify existing documents. Dates use YYYY-MM-DD. endDate must be on or after startDate. status: pending, confirmed, completed, or cancelled.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Reservation"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created. The response contains the new document id.",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "507f1f77bcf86cd799439011"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Invalid fields, dates, or document references"
          },
          "401": {
            "description": "Authentication required. Please log in through GitHub."
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "githubAuth": []
          }
        ]
      }
    },
    "/reservations/{id}": {
      "get": {
        "tags": [
          "Reservations"
        ],
        "summary": "Get a reservation by ID",
        "description": "Returns the reservation matching the supplied MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The 24-character MongoDB ID of the reservation"
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation returned"
          },
          "400": {
            "description": "Invalid document ID"
          },
          "404": {
            "description": "Reservation not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "tags": [
          "Reservations"
        ],
        "summary": "Update a reservation",
        "description": "Send all fields. inventoryId and customerId must identify existing documents. Dates use YYYY-MM-DD. endDate must be on or after startDate. status: pending, confirmed, completed, or cancelled.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The 24-character MongoDB ID of the reservation"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Reservation"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Updated successfully. No response body."
          },
          "400": {
            "description": "Invalid ID, fields, dates, or document references"
          },
          "401": {
            "description": "Authentication required. Please log in through GitHub."
          },
          "404": {
            "description": "Reservation not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "githubAuth": []
          }
        ]
      }
    }
  },
  "definitions": {
    "Inventory": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Excavator"
        },
        "description": {
          "type": "string",
          "example": "Tracked excavator for construction work."
        },
        "category": {
          "type": "string",
          "example": "Heavy Machinery"
        },
        "serialNumber": {
          "type": "string",
          "example": "EXC-001"
        },
        "dailyRate": {
          "type": "number",
          "example": 1500
        },
        "status": {
          "type": "string",
          "example": "available"
        },
        "condition": {
          "type": "string",
          "example": "Good"
        }
      }
    },
    "Customer": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "example": "John"
        },
        "lastName": {
          "type": "string",
          "example": "Doe"
        },
        "email": {
          "type": "string",
          "example": "john@example.com"
        },
        "phone": {
          "type": "string",
          "example": "555-123-4567"
        }
      }
    },
    "Maintenance": {
      "type": "object",
      "properties": {
        "inventoryId": {
          "type": "string",
          "example": "507f1f77bcf86cd799439011"
        },
        "description": {
          "type": "string",
          "example": "Leo Swagger maintenance test"
        },
        "scheduledDate": {
          "type": "string",
          "example": "2026-10-15"
        },
        "status": {
          "type": "string",
          "example": "scheduled"
        },
        "cost": {
          "type": "number",
          "example": 30
        }
      }
    },
    "Reservation": {
      "type": "object",
      "properties": {
        "inventoryId": {
          "type": "string",
          "example": "507f1f77bcf86cd799439011"
        },
        "customerId": {
          "type": "string",
          "example": "507f1f77bcf86cd799439012"
        },
        "startDate": {
          "type": "string",
          "example": "2026-10-15"
        },
        "endDate": {
          "type": "string",
          "example": "2026-10-16"
        },
        "status": {
          "type": "string",
          "example": "pending"
        }
      }
    }
  }
}

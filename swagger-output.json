{
  "swagger": "2.0",
  "info": {
    "title": "Equipment Tracker API",
    "description": "API for managing inventory, customers, maintenance orders, and reservations. Open /auth/github in a browser tab to sign in with GitHub, then return to /api-docs. Do not use Swagger Execute for login or logout.",
    "version": "1.0.0"
  },
  "basePath": "/",
  "securityDefinitions": {
    "githubAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Cookie",
      "description": "Open /auth/github in a browser tab to sign in with GitHub, then return to /api-docs. Do not use Swagger Execute for login or logout."
    }
  },
  "paths": {
    "/auth/github": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Sign in with GitHub",
        "description": "Open this link in a browser to start GitHub OAuth. Do not use Swagger Execute; after login, return to the API Docs tab.",
        "responses": {
          "302": {
            "description": "Redirects the browser to GitHub for authentication"
          },
          "500": {
            "description": "Authentication could not be started"
          }
        }
      }
    },
    "/login": {
      "get": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/logout": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log out",
        "description": "Open this link in a browser to end the current session. Do not use Swagger Execute; the browser redirects to API Docs after logout.",
        "responses": {
          "302": {
            "description": "Session ended and browser redirected to API Docs"
          },
          "500": {
            "description": "Logout failed"
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/inventory": {
      "get": {
        "summary": "List all inventory items",
        "description": "Returns every inventory item in the collection.",
        "responses": {
          "200": {
            "description": "Inventory items returned"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/Inventory"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Inventory item created"
          },
          "400": {
            "description": "Invalid inventory data"
          },
          "401": {
            "description": "Authentication required. Please log in through GitHub."
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "githubAuth": []
          }
        ]
      }
    },
    "/inventory/{id}": {
      "get": {
        "summary": "Get an inventory item by ID",
        "description": "Returns the inventory item matching the supplied MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Inventory item returned"
          },
          "400": {
            "description": "Invalid document ID"
          },
          "404": {
            "description": "Inventory item not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/Inventory"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Inventory item updated"
          },
          "400": {
            "description": "Invalid ID or inventory data"
          },
          "401": {
            "description": "Authentication required. Please log in through GitHub."
          },
          "404": {
            "description": "Inventory item not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "githubAuth": []
          }
        ]
      },
      "delete": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "Inventory item deleted"
          },
          "400": {
            "description": "Invalid document ID"
          },
          "401": {
            "description": "Authentication required. Please log in through GitHub."
          },
          "404": {
            "description": "Inventory item not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "githubAuth": []
          }
        ]
      }
    },
